{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build and run tests",
      "type": "shell",
      "command": "make test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "C++: clean build",
      "type": "shell",
      "command": "make clean",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
