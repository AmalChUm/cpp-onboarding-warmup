{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build and run warm-up tests",
      "type": "shell",
      "command": "make test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "C++: build and run warm-up tests (no make)",
      "type": "shell",
      "command": "mkdir -p build && g++ -std=c++17 -Wall -Wextra -pedantic -g src/warmup.cpp tests/warmup_tests.cpp -o build/warmup_test && ./build/warmup_test",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "C++: clean build",
      "type": "shell",
      "command": "make clean",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
